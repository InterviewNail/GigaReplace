<Window x:Class="GigaReplace.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GigaReplace.Views"
        Title="{Binding WindowTitle}"
        Width="1320" Height="880" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: name and profile commands -->
        <Border Padding="20,12" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Profile" Style="{StaticResource Hint}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button Content="New" Command="{Binding NewProfileCommand}" Margin="0,0,6,0" ToolTip="Start over with default settings" />
                    <Button Content="Open…" Command="{Binding OpenProfileCommand}" Margin="0,0,6,0" ToolTip="Load saved settings" />
                    <Button Content="Save" Command="{Binding SaveProfileCommand}" Margin="0,0,6,0" ToolTip="Save these settings to reuse later" />
                    <Button Content="Save as…" Command="{Binding SaveProfileAsCommand}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" FontSize="22" Margin="0,0,10,0"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Text="GigaReplace" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="Rename across a .NET solution, safely" Style="{StaticResource Hint}" FontSize="13"
                               VerticalAlignment="Center" Margin="14,3,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTab}" Margin="12,8,12,0">
            <TabItem Header="1  Setup">
                <views:SetupView DataContext="{Binding Setup}" />
            </TabItem>
            <TabItem Header="{Binding Review.TabHeader}">
                <views:ReviewView DataContext="{Binding Review}" />
            </TabItem>
            <TabItem Header="3  Results">
                <views:ResultsView DataContext="{Binding Results}" />
            </TabItem>
        </TabControl>

        <!-- Status bar -->
        <Border Grid.Row="2" Padding="16,8" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Cancel" Command="{Binding CancelCommand}"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <ProgressBar DockPanel.Dock="Right" Width="240" Height="4" Margin="12,0" VerticalAlignment="Center"
                             Value="{Binding ProgressValue}" IsIndeterminate="{Binding ProgressIsIndeterminate}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
