<UserControl x:Class="GigaReplace.Views.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="1120" Margin="8,12,8,8">

            <!-- 1. Source -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="1  What to process" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Solution file or folder"
                                 ToolTip="A folder, or a .sln / .slnx file (its folder is processed)" />
                        <Button Grid.Column="1" Content="Folder…" Command="{Binding BrowseSourceFolderCommand}" Margin="8,0,0,0" />
                        <Button Grid.Column="2" Content="Solution…" Command="{Binding BrowseSolutionCommand}" Margin="8,0,0,0" />
                    </Grid>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                               Text="Everything under this folder is processed. Choosing a .sln or .slnx file processes the folder it's in." />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="320" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Profile name" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBox Grid.Column="1" Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Profile name" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 2. Rules -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Command="{Binding AddRuleCommand}" AutomationProperties.Name="Add a pair">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" Margin="0,0,6,0" />
                                <TextBlock Text="Add a pair" />
                            </StackPanel>
                        </Button>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="2  Find and replace" />
                    </DockPanel>

                    <Grid Margin="0,4,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="112" />
                            <ColumnDefinition Width="124" />
                            <ColumnDefinition Width="116" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="On" Style="{StaticResource Hint}" />
                        <TextBlock Grid.Column="1" Text="Find" Style="{StaticResource Hint}" />
                        <TextBlock Grid.Column="3" Text="Replace with" Style="{StaticResource Hint}" />
                        <TextBlock Grid.Column="4" Text="Match case" Style="{StaticResource Hint}" Margin="8,0,0,0" />
                        <TextBlock Grid.Column="5" Text="Preserve case" Style="{StaticResource Hint}" Margin="8,0,0,0" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Rules}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="112" />
                                        <ColumnDefinition Width="124" />
                                        <ColumnDefinition Width="116" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center" MinWidth="0"
                                              AutomationProperties.Name="Use this pair" ToolTip="Use this pair" />
                                    <TextBox Grid.Column="1" Text="{Binding Find, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="{StaticResource CodeFont}" AutomationProperties.Name="Find" />
                                    <Button Grid.Column="2" Command="{Binding SwapCommand}" HorizontalAlignment="Center" Padding="6,5"
                                            ToolTip="Swap Find and Replace with" AutomationProperties.Name="Swap Find and Replace with">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8AB;" />
                                    </Button>
                                    <TextBox Grid.Column="3" Text="{Binding Replace, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="{StaticResource CodeFont}" AutomationProperties.Name="Replace with" />
                                    <CheckBox Grid.Column="4" IsChecked="{Binding MatchCase}" Content="Strict" Margin="8,0,0,0" MinWidth="0"
                                              VerticalAlignment="Center" ToolTip="Only match text with exactly this casing" />
                                    <CheckBox Grid.Column="5" IsChecked="{Binding PreserveCase}" IsEnabled="{Binding CanPreserveCase}"
                                              Content="Mirror" Margin="8,0,0,0" MinWidth="0" VerticalAlignment="Center"
                                              ToolTip="Give each match's replacement the same casing: orderHub → salesDesk, ORDERHUB → SALESDESK" />
                                    <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Command="{Binding DataContext.MoveRuleUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" ToolTip="Move up (earlier rules match first)" Padding="8,5"
                                                AutomationProperties.Name="Move up">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE74A;" />
                                        </Button>
                                        <Button Command="{Binding DataContext.MoveRuleDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" ToolTip="Move down" Padding="8,5" Margin="4,0"
                                                AutomationProperties.Name="Move down">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE74B;" />
                                        </Button>
                                        <Button Command="{Binding DataContext.RemoveRuleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" ToolTip="Remove this pair" Padding="8,5"
                                                AutomationProperties.Name="Remove">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                               Text="Matching ignores case unless Strict is on. Mirror gives each match the replacement's words in the match's casing: OrderHub → SalesDesk also turns orderHub into salesDesk and ORDERHUB into SALESDESK. Pairs run top to bottom, and text an earlier pair matched isn't matched again." />
                </StackPanel>
            </Border>

            <!-- 3. Scope -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="3  What to change" />
                    <WrapPanel>
                        <CheckBox Content="Text inside files" IsChecked="{Binding ReplaceInContents}" Margin="0,0,24,0" />
                        <CheckBox Content="File names" IsChecked="{Binding RenameFiles}" Margin="0,0,24,0" />
                        <CheckBox Content="Folder names" IsChecked="{Binding RenameFolders}" />
                    </WrapPanel>

                    <DockPanel Margin="0,12,0,4">
                        <Button DockPanel.Dock="Right" Content="Reset to defaults" Command="{Binding ResetExclusionsCommand}" Padding="10,3" />
                        <TextBlock Text="Skip these (one per line, .gitignore syntax)" FontWeight="SemiBold" VerticalAlignment="Bottom" />
                    </DockPanel>
                    <TextBox Text="{Binding ExcludePatterns}" AcceptsReturn="True" TextWrapping="NoWrap" Height="104"
                             VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource CodeFont}"
                             AutomationProperties.Name="Paths to skip" />
                    <CheckBox Content="Also skip whatever the .gitignore files in the tree exclude" IsChecked="{Binding RespectGitIgnore}" Margin="0,8,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Don't edit the text of files larger than" VerticalAlignment="Center" />
                        <TextBox Text="{Binding MaxFileSizeMb}" Width="64" Margin="8,0" AutomationProperties.Name="Largest file to edit, in MB" />
                        <TextBlock Text="MB" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                               Text=".git folders are never changed. Binary files (images, DLLs, …) are never edited, but can be renamed. Each file keeps its encoding, byte order mark and line endings." />
                </StackPanel>
            </Border>

            <!-- 4. Risk checks -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="4  Ask me before changing…" />

                    <CheckBox IsChecked="{Binding CheckBuildBreakers}" Margin="0,2,0,8" AutomationProperties.Name="Build breakers">
                        <StackPanel>
                            <TextBlock Text="Build breakers" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Matches inside other words (“nail” in Thumbnail), new names that clash with or hide existing ones, names that come from .NET or NuGet, invalid names, and unusual casing." />
                        </StackPanel>
                    </CheckBox>

                    <CheckBox IsChecked="{Binding CheckPersistedData}" Margin="0,0,0,8" AutomationProperties.Name="Persisted or external data">
                        <StackPanel>
                            <TextBlock Text="Persisted or external data" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Names that live outside the code: serialized properties, settings and JSON keys, registry paths, AppData folders, URLs, mutex and pipe names, resource keys, environment variables." />
                        </StackPanel>
                    </CheckBox>

                    <CheckBox IsChecked="{Binding CheckAppIdentity}" Margin="0,0,0,4" AutomationProperties.Name="App identity">
                        <StackPanel>
                            <TextBlock Text="App identity" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Assembly names, root namespaces, package IDs, InternalsVisibleTo, installer and manifest identities, and project files whose default names would change." />
                        </StackPanel>
                    </CheckBox>
                    <CheckBox IsChecked="{Binding RegenerateIdentityGuids}" Margin="30,4,0,10" AutomationProperties.Name="Give the result new identity GUIDs">
                        <StackPanel>
                            <TextBlock Text="Give the result new identity GUIDs" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="UpgradeCode, ProductCode, ProjectGuid, UserSecretsId and assembly GUIDs get new values everywhere they appear, so the result can be installed next to the original." />
                        </StackPanel>
                    </CheckBox>

                    <CheckBox IsChecked="{Binding CheckWatchList}" Margin="0,0,0,6" AutomationProperties.Name="My watch-list">
                        <StackPanel>
                            <TextBlock Text="My watch-list" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Any match on a line containing one of these. One term per line; wrap a line in slashes for a regular expression, like /Secret\w*/." />
                        </StackPanel>
                    </CheckBox>
                    <TextBox Text="{Binding WatchList}" AcceptsReturn="True" TextWrapping="NoWrap" Height="78" Margin="30,0,0,0"
                             VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource CodeFont}"
                             IsEnabled="{Binding CheckWatchList}" AutomationProperties.Name="Watch-list terms" />

                    <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0"
                               Text="Unchecked kinds are changed without asking. Before anything is written, every run also checks for names renamed in only some places, clashing file names, broken file references and characters a file's encoding can't store." />
                </StackPanel>
            </Border>

            <!-- 5. Output -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="5  Where the result goes, and how to ask" />

                    <RadioButton GroupName="WriteMode" IsChecked="{Binding WriteMode, Converter={StaticResource EnumToBool}, ConverterParameter=CopyToFolder}" AutomationProperties.Name="Copy to a new folder">
                        <StackPanel>
                            <TextBlock Text="Copy to a new folder" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Hint}" Text="The source isn't touched. Skipped and git-ignored files (bin, obj, .vs, …) aren't copied." />
                        </StackPanel>
                    </RadioButton>
                    <StackPanel Margin="30,8,0,12" IsEnabled="{Binding WriteMode, Converter={StaticResource EnumToBool}, ConverterParameter=CopyToFolder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding DestinationPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Destination folder"
                                     ToolTip="An empty folder, or one that doesn't exist yet" />
                            <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseDestinationCommand}" Margin="8,0,0,0" />
                            <Button Grid.Column="2" Content="Suggest" Command="{Binding SuggestDestinationPathCommand}" Margin="8,0,0,0"
                                    ToolTip="Next to the source, named with your replacements applied" />
                        </Grid>
                        <CheckBox Content="Also copy the .git folder (history), unchanged" IsChecked="{Binding CopyGitFolder}" Margin="0,8,0,0" />
                    </StackPanel>

                    <RadioButton GroupName="WriteMode" IsChecked="{Binding WriteMode, Converter={StaticResource EnumToBool}, ConverterParameter=InPlace}" Margin="0,0,0,16" AutomationProperties.Name="Change the files in place">
                        <StackPanel>
                            <TextBlock Text="Change the files in place" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Hint}" Text="An undo journal keeps the original bytes of every file it changes, so the Results tab can put everything back." />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton GroupName="PromptMode" IsChecked="{Binding PromptMode, Converter={StaticResource EnumToBool}, ConverterParameter=ReviewFirst}" Margin="0,0,0,8" AutomationProperties.Name="Review screen first">
                        <StackPanel>
                            <TextBlock Text="Review screen first" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Hint}" Text="Scan everything, then decide on one screen. Flagged changes need a decision before you can apply, and you can step through them one at a time." />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="PromptMode" IsChecked="{Binding PromptMode, Converter={StaticResource EnumToBool}, ConverterParameter=PromptDuringRun}" AutomationProperties.Name="Prompt during the run">
                        <StackPanel>
                            <TextBlock Text="Prompt during the run" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Hint}" Text="Ask about each flagged change as the run reaches it, then offer to apply." />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>

            <DockPanel Margin="0,0,0,16">
                <Button DockPanel.Dock="Right" Style="{DynamicResource AccentButtonStyle}" Padding="28,8" FontSize="15"
                        Command="{Binding DataContext.ScanCommand, RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.Name="Scan">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" Margin="0,0,8,0" />
                        <TextBlock Text="Scan" />
                    </StackPanel>
                </Button>
                <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" FontSize="13"
                           Text="Scanning only reads files. Nothing is written until you apply." />
            </DockPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
