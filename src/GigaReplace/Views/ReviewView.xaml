<UserControl x:Class="GigaReplace.Views.ReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="4,10,4,6">
        <TextBlock Text="Nothing to review yet. Set things up on the Setup tab and press Scan."
                   Style="{StaticResource Hint}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding HasScan, Converter={StaticResource InverseBoolToVisibility}}" />

        <Grid Visibility="{Binding HasScan, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Summary -->
            <DockPanel Margin="0,0,0,10">
                <Button DockPanel.Dock="Right" Command="{Binding StepThroughCommand}" Padding="14,6" AutomationProperties.Name="Step through flagged changes"
                        ToolTip="Show the flagged changes one at a time and decide each">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Step through flagged changes" />
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE76C;" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <StackPanel>
                    <TextBlock Text="{Binding SummaryText}" FontSize="16" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Margin="0,0,6,0"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                   Visibility="{Binding PendingCount, Converter={StaticResource HasValue}}" />
                        <TextBlock Text="{Binding DecisionText}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0" Visibility="{Binding RememberedText, Converter={StaticResource HasValue}}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE81C;" Margin="0,0,6,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="{Binding RememberedText}" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>

            <!-- Filters -->
            <DockPanel Grid.Row="1" Margin="0,0,0,8">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="Set all shown to" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource Hint}" FontSize="13" />
                    <Button Content="Replace" Command="{Binding SetShownCommand}" CommandParameter="Replace" Margin="0,0,6,0" />
                    <Button Content="Skip" Command="{Binding SetShownCommand}" CommandParameter="Skip" />
                </StackPanel>
                <WrapPanel>
                    <ComboBox ItemsSource="{Binding FilterOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding Filter}" Width="210" Margin="0,0,8,0" AutomationProperties.Name="Show" />
                    <ComboBox ItemsSource="{Binding CategoryOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding Category}" Width="210" Margin="0,0,8,0" AutomationProperties.Name="Reason" />
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="240" Margin="0,0,10,0"
                             AutomationProperties.Name="Search" ToolTip="Search paths, names, lines and reasons" />
                    <TextBlock Text="{Binding ShownText}" VerticalAlignment="Center" Style="{StaticResource Hint}" FontSize="13" />
                </WrapPanel>
            </DockPanel>

            <!-- Banners -->
            <StackPanel Grid.Row="2">
                <Border Background="{DynamicResource SystemFillColorCautionBackgroundBrush}" CornerRadius="6" Padding="12,8" Margin="0,0,0,8"
                        Visibility="{Binding IsStale, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Margin="0,0,8,0" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                        <TextBlock Text="The files were changed in place after this scan. Scan again before making more changes." TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}" CornerRadius="6" Padding="12,6" Margin="0,0,0,8"
                        Visibility="{Binding OnlyFilterText, Converter={StaticResource HasValue}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Show everything" Command="{Binding ClearOnlyCommand}" Padding="10,3" />
                        <TextBlock Text="{Binding OnlyFilterText}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>
                </Border>
            </StackPanel>

            <!-- List and details -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="420" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="440" MinWidth="320" />
                </Grid.ColumnDefinitions>

                <DataGrid x:Name="ItemsGrid" ItemsSource="{Binding ItemsView}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                          AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow"
                          HeadersVisibility="Column" GridLinesVisibility="None" CanUserResizeRows="False" CanUserAddRows="False"
                          EnableRowVirtualization="True" EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          MouseDoubleClick="OnGridDoubleClick" AutomationProperties.Name="Changes">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="36" SortMemberPath="Decision" CanUserResize="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource DecisionGlyph}" ToolTip="{Binding Decision, Converter={StaticResource DecisionText}}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="File or folder" Binding="{Binding RelativePath}" Width="2*" ElementStyle="{StaticResource CellText}" />
                        <DataGridTextColumn Header="Line" Binding="{Binding LineDisplay}" SortMemberPath="Line" Width="72" ElementStyle="{StaticResource CellText}" />
                        <DataGridTemplateColumn Header="Change" Width="2*" SortMemberPath="WordText">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource CellText}" FontFamily="{StaticResource CodeFont}" FontSize="12">
                                        <Run Text="{Binding WordText, Mode=OneWay}" /><Run Text=" → " Foreground="{DynamicResource TextFillColorTertiaryBrush}" /><Run Text="{Binding WordPreviewText, Mode=OneWay}" FontWeight="SemiBold" />
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Where" Binding="{Binding ContextDetail}" Width="1.4*" ElementStyle="{StaticResource CellText}" />
                        <DataGridTextColumn Header="Why it's flagged" Binding="{Binding RiskSummary}" Width="1.4*" ElementStyle="{StaticResource ReasonCellText}" />
                        <DataGridTextColumn Header="Decision" Binding="{Binding DecisionDisplay}" SortMemberPath="Decision"
                                            Width="150" ElementStyle="{StaticResource CellText}" />
                    </DataGrid.Columns>
                </DataGrid>

                <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />

                <!-- Details -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0" Padding="16,14">
                    <Grid>
                        <TextBlock Text="Select a change to see where it is and why it was flagged." Style="{StaticResource Hint}"
                                   Visibility="{Binding Details, Converter={StaticResource HasValue}, ConverterParameter=invert}" />
                        <Grid Visibility="{Binding Details, Converter={StaticResource HasValue}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" DataContext="{Binding Details}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Header}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Where}" Style="{StaticResource Hint}" Margin="0,2,0,10" />
                                    <Border Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,10"
                                            Visibility="{Binding Item.RememberedNote, Converter={StaticResource HasValue}}">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Forget" Padding="10,3" Margin="8,0,0,0" VerticalAlignment="Center"
                                                    Command="{Binding DataContext.ForgetSelectedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    ToolTip="Go back to what the scan proposed, and don't remember this decision" />
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE81C;" Margin="0,2,8,0" VerticalAlignment="Top" />
                                            <TextBlock Text="{Binding Item.RememberedNote}" TextWrapping="Wrap" />
                                        </DockPanel>
                                    </Border>
                                    <TextBlock Text="Why it's flagged" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                    <ItemsControl ItemsSource="{Binding Risks}" ItemTemplate="{StaticResource RiskTemplate}"
                                                  Visibility="{Binding HasRisks, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Style="{StaticResource Hint}" Text="Nothing suspicious was found, so this change was approved automatically."
                                               Visibility="{Binding HasRisks, Converter={StaticResource InverseBoolToVisibility}}" />

                                    <TextBlock Text="Where it is" Style="{StaticResource FieldLabel}" />
                                    <Border Style="{StaticResource CodeBox}">
                                        <StackPanel>
                                            <ItemsControl ItemsSource="{Binding Lines}" ItemTemplate="{StaticResource PreviewLineTemplate}" />
                                            <Grid Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="44" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="after" FontFamily="{StaticResource CodeFont}" FontSize="11" HorizontalAlignment="Right" Margin="0,1,10,0"
                                                           Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                                                <TextBlock Grid.Column="1" FontFamily="{StaticResource CodeFont}" FontSize="12" TextWrapping="Wrap">
                                                    <Run Text="{Binding LineBefore, Mode=OneWay}" /><Run Text="{Binding Item.PreviewText, Mode=OneWay}" FontWeight="Bold"
                                                         Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}" /><Run Text="{Binding LineAfter, Mode=OneWay}" />
                                                </TextBlock>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                </StackPanel>
                            </ScrollViewer>

                            <StackPanel Grid.Row="1" Margin="0,10,0,0">
                                <Separator Margin="0,0,0,8" />
                                <TextBlock Text="Apply the decision to" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <RadioButton Content="This change only" GroupName="Scope" MinWidth="0"
                                             IsChecked="{Binding Scope, Converter={StaticResource EnumToBool}, ConverterParameter=ThisOnly}" />
                                <RadioButton GroupName="Scope" MinWidth="0"
                                             IsChecked="{Binding Scope, Converter={StaticResource EnumToBool}, ConverterParameter=SameName}"
                                             Visibility="{Binding Details.HasSymbolGroup, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding Details.SymbolScopeText}" TextWrapping="Wrap" />
                                </RadioButton>
                                <RadioButton GroupName="Scope" MinWidth="0"
                                             IsChecked="{Binding Scope, Converter={StaticResource EnumToBool}, ConverterParameter=Similar}"
                                             Visibility="{Binding Details.HasSimilar, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding Details.SimilarScopeText}" TextWrapping="Wrap" />
                                </RadioButton>

                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Style="{DynamicResource AccentButtonStyle}" Command="{Binding ReplaceSelectedCommand}" Padding="16,5" Margin="0,0,8,0" AutomationProperties.Name="Replace">
                                        <TextBlock>
                                            <Run Text="Replace with “" /><Run Text="{Binding SelectedItem.ProposedText, Mode=OneWay}" /><Run Text="”" />
                                        </TextBlock>
                                    </Button>
                                    <Button Content="Skip" Command="{Binding SkipSelectedCommand}" Padding="16,5" Margin="0,0,8,0"
                                            ToolTip="Leave this text as it is" />
                                    <Button Content="Reset" Command="{Binding ResetSelectedCommand}" ToolTip="Back to what the scan proposed" />
                                </StackPanel>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Margin="0,0,8,0">
                                        <Run Text="Or use custom text for “" /><Run Text="{Binding SelectedItem.OriginalText, Mode=OneWay}" /><Run Text="”:" />
                                    </TextBlock>
                                    <TextBox Grid.Column="1" Text="{Binding CustomText, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource CodeFont}"
                                             AutomationProperties.Name="Custom replacement" />
                                    <Button Grid.Column="2" Content="Use" Command="{Binding UseCustomTextCommand}" Margin="8,0,0,0" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Problems and notes -->
            <StackPanel Grid.Row="4" Margin="0,8,0,0">
                <Expander IsExpanded="{Binding HasProblems, Mode=OneWay}" HorizontalAlignment="Stretch">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Margin="0,0,8,0" Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                       Visibility="{Binding HasProblems, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" Margin="0,0,8,0" Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                       Visibility="{Binding HasProblems, Converter={StaticResource InverseBoolToVisibility}}" />
                            <TextBlock Text="{Binding ProblemsHeader}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Expander.Header>
                    <ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Problems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="Glyph" Style="{StaticResource Icon}" Text="&#xE7BA;" VerticalAlignment="Top" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,2,0,6" />
                                            <WrapPanel>
                                                <ItemsControl ItemsSource="{Binding Fixes}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Content="{Binding Label}" Command="{Binding Command}" Margin="0,0,6,0" Padding="10,3" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Button Content="{Binding ShowText}" Command="{Binding ShowCommand}" Padding="10,3" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                            <Setter TargetName="Glyph" Property="Text" Value="&#xEA39;" />
                                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Expander>

                <Expander Margin="0,6,0,0" HorizontalAlignment="Stretch"
                          Visibility="{Binding Notes.Count, Converter={StaticResource HasValue}}">
                    <Expander.Header>
                        <TextBlock>
                            <Run Text="Notes from the scan (" /><Run Text="{Binding Notes.Count, Mode=OneWay}" /><Run Text=")" />
                        </TextBlock>
                    </Expander.Header>
                    <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Notes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Style="{StaticResource Hint}" Margin="0,0,0,4" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Expander>
            </StackPanel>

            <!-- Apply -->
            <DockPanel Grid.Row="5" Margin="0,10,0,0">
                <Button DockPanel.Dock="Left" Content="Export CSV…" Command="{Binding ExportCsvCommand}" />
                <Button DockPanel.Dock="Right" Style="{DynamicResource AccentButtonStyle}" Padding="22,8" FontSize="14"
                        Content="{Binding DataContext.ApplyText, RelativeSource={RelativeSource AncestorType=Window}}"
                        Command="{Binding DataContext.ApplyCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                <TextBlock Text="{Binding DataContext.ApplyHint, RelativeSource={RelativeSource AncestorType=Window}}"
                           Style="{StaticResource Hint}" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0" />
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
