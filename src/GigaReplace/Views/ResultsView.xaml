<UserControl x:Class="GigaReplace.Views.ResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="4,12,4,6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Outcome -->
        <Border Style="{StaticResource Card}">
            <Grid>
                <TextBlock Style="{StaticResource Hint}" FontSize="14" Text="Nothing applied in this session yet. Scan, review, then apply."
                           Visibility="{Binding HasResult, Converter={StaticResource InverseBoolToVisibility}}" />
                <StackPanel Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="18" Margin="0,0,10,0"
                                   Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                        <TextBlock Text="Done" FontSize="16" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock Text="{Binding ResultSummary}" TextWrapping="Wrap" Margin="0,6,0,8" />
                    <ItemsControl ItemsSource="{Binding ResultNotes}" Margin="0,0,0,8"
                                  Visibility="{Binding ResultNotes.Count, Converter={StaticResource HasValue}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Margin="0,0,8,0" VerticalAlignment="Top"
                                               Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="1100" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <WrapPanel>
                        <Button Content="Open the folder" Command="{Binding OpenOutputFolderCommand}" Margin="0,0,8,0" />
                        <Button Style="{DynamicResource AccentButtonStyle}" Command="{Binding BuildCommand}" Margin="0,0,8,0" AutomationProperties.Name="Build it with dotnet"
                                ToolTip="Run dotnet build on the result to catch anything the checks missed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE90F;" Margin="0,0,8,0" />
                                <TextBlock Text="Build it with dotnet" />
                            </StackPanel>
                        </Button>
                        <Button Content="Cancel build" Command="{Binding CancelBuildCommand}" Margin="0,0,8,0"
                                Visibility="{Binding IsBuilding, Converter={StaticResource BoolToVisibility}}" />
                        <Button Command="{Binding UndoResultCommand}" AutomationProperties.Name="Undo this run"
                                Visibility="{Binding CanUndoResult, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7A7;" Margin="0,0,8,0" />
                                <TextBlock Text="Undo this run" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Build check -->
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Build check" Margin="0,0,0,4" />
                    <TextBlock x:Name="BuildSummaryText" Text="{Binding BuildSummary}" TextWrapping="Wrap" Margin="0,0,0,8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BuildSucceeded}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding BuildSucceeded}" Value="False">
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                               Text="After applying, run dotnet build on the result to catch anything the checks missed."
                               Visibility="{Binding BuildSummary, Converter={StaticResource HasValue}, ConverterParameter=invert}" />
                </StackPanel>

                <ListBox Grid.Row="1" ItemsSource="{Binding BuildErrors}" MaxHeight="170" Margin="0,0,0,8"
                         Visibility="{Binding BuildErrors.Count, Converter={StaticResource HasValue}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock TextWrapping="Wrap">
                                <Run Text="{Binding Code, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                                <Run Text="{Binding Message, Mode=OneWay}" />
                                <LineBreak />
                                <Run Text="{Binding File, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                                <Run Text="{Binding Line, Mode=OneWay, StringFormat=line {0}}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBox x:Name="LogBox" Grid.Row="2" IsReadOnly="True" FontFamily="{StaticResource CodeFont}" FontSize="12"
                         TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         MinHeight="120" AutomationProperties.Name="Build output" />
            </Grid>
        </Border>

        <!-- Undo -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Open journal folder" Command="{Binding OpenJournalFolderCommand}" Padding="10,3" />
                    <TextBlock Style="{StaticResource SectionTitle}" Text="In-place runs you can undo" Margin="0,0,0,6" />
                </DockPanel>
                <TextBlock Style="{StaticResource Hint}" Text="No in-place runs yet. Copies don't need undo; just delete the copy."
                           Visibility="{Binding Journals.Count, Converter={StaticResource HasValue}, ConverterParameter=invert}" />
                <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Journals}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding Folder, Mode=OneWay}" FontWeight="SemiBold" />
                                            <Run Text="{Binding When, Mode=OneWay, StringFormat=· {0}}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <Run Text="{Binding State, Mode=OneWay, StringFormat=· {0}}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource Hint}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Undo" Margin="12,0,0,0" VerticalAlignment="Center"
                                            Command="{Binding DataContext.UndoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" IsEnabled="{Binding CanUndo}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
